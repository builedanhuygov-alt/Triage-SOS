# Demo only — KHÔNG commit file .env thật (đã bị .gitignore chặn).
# Copy thành .env khi cần đổi secret/port.
# Môi trường: development | staging | production (NODE_ENV)
PORT=5000
AUTH_SECRET=doi-secret-nay-khi-production
DATABASE_URL=./data/hospital.db
DATABASE_PATH=./data/hospital.db
ALLOW_DEMO_SEED=
QR_SECRET=doi-qr-secret-nay-khi-production
CORS_ORIGINS=
API_BASE_URL=http://localhost:5000
PUBLIC_APP_URL=
PATIENT_APP_URL=
EMAIL_PROVIDER=simulated
MAPS_API_KEY=
# Production: đặt NODE_ENV=production, DATABASE_URL trỏ disk persistent,
# AUTH_SECRET/QR_SECRET random mạnh, CORS_ORIGINS whitelist, EMAIL_PROVIDER thật khi có.
